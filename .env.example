# SkyStream web — environment contract
#
# Copy to .env.local for local development. For the container image,
# these are BUILD arguments, not runtime variables — see "Build vs runtime".
#
# ── Build vs runtime ────────────────────────────────────────────────────────
# Every variable below is NEXT_PUBLIC_*, which Next.js inlines into the bundle
# at `next build`. Nothing here can be changed by setting it on a running
# container: `docker run -e NEXT_PUBLIC_TMDB_API_KEY=...` has no effect. To
# change any of these you rebuild the image with a new --build-arg, which on
# Coolify means a *build-time* variable, not a runtime one.
#
# That also means NEXT_PUBLIC_TMDB_API_KEY is baked into the image and served
# to every browser. That is the app's existing design — the client calls TMDB
# directly — not something the container introduced. Treat the key as public;
# TMDB read keys are rate-limited, not privileged. Never put a genuinely
# secret value in a NEXT_PUBLIC_* variable.
#
# .env.production holds the committed non-secret defaults and is read
# at build time. Only the values that have no safe default need to be supplied.

# ── Required ────────────────────────────────────────────────────────────────

# TMDB API key (v3 auth). No default — an image built without it renders the
# shell but every TMDB call returns 401, so /movie and /tv pages come back
# empty. Build logs a FATAL line when it is missing.
NEXT_PUBLIC_TMDB_API_KEY=

# ── Optional — defaults live in .env.production ─────────────────────

NEXT_PUBLIC_APP_NAME=SkyStream
NEXT_PUBLIC_APP_VERSION=2.0.0
NEXT_PUBLIC_APP_DESCRIPTION=Your ultimate destination for streaming movies and TV shows

NEXT_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
NEXT_PUBLIC_DEFAULT_POSTER_SIZE=w500
NEXT_PUBLIC_DEFAULT_BACKDROP_SIZE=w1280

# VidSrc supports CNAME'ing a custom domain at it (fewer ads, no-click
# autoplay) — swap this to move to a custom domain without a code change.
# next.config.mjs derives the CSP frame-src from this value at build time, so
# changing it requires a rebuild for the player iframe to be allowed.
NEXT_PUBLIC_VIDSRC_BASE_URL=https://vidsrcme.ru
NEXT_PUBLIC_DEFAULT_PLAYER=vidsrc
NEXT_PUBLIC_AUTO_PLAY=true

NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_GA_TRACKING_ID=G-CR3ZVV9BE1
NEXT_PUBLIC_ENABLE_CONSOLE_LOGS=false

# ── True runtime variables (read by the standalone server, no rebuild) ──────
# PORT      — listen port, default 3000
# HOSTNAME  — bind address, default 0.0.0.0 (must not be 127.0.0.1 in a container)

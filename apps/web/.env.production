# SkyStream Production Environment Configuration
# Loaded by Next.js at build time for every production build, including the
# container image (apps/web/Dockerfile). Non-secret defaults only.

# Application
NEXT_PUBLIC_APP_NAME=SkyStream
NEXT_PUBLIC_APP_VERSION=2.0.0
NEXT_PUBLIC_APP_DESCRIPTION=Your ultimate destination for streaming movies and TV shows

# Logging (off in production)
NEXT_PUBLIC_ENABLE_CONSOLE_LOGS=false

# TMDB API
# NEXT_PUBLIC_TMDB_API_KEY is NOT set here — it is supplied per build, as a
# --build-arg locally and a build-time variable in Coolify, so it never lives
# in the repository. See apps/web/.env.example for the full contract.
NEXT_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
NEXT_PUBLIC_DEFAULT_POSTER_SIZE=w500
NEXT_PUBLIC_DEFAULT_BACKDROP_SIZE=w1280

# Video player (VidSrc) — swap this to a CNAME'd custom domain for fewer
# ads and no-click autoplay; that's a config change here, not a code change.
NEXT_PUBLIC_VIDSRC_BASE_URL=https://vidsrcme.ru
NEXT_PUBLIC_DEFAULT_PLAYER=vidsrc
NEXT_PUBLIC_AUTO_PLAY=true

# Analytics
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_GA_TRACKING_ID=G-CR3ZVV9BE1
